		{
			"name": "Marketplace Listings",
			"description": "APIs to create, filter, search, update, archive, and manage image gallery for catalog listings.",
			"item": [
				{
					"name": "Create Listing",
					"request": {
						"description": "Creates a product listing. Seller is automatically bound from authenticated user JWT token.",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"categoryId\": 1,\n  \"title\": \"Introduction to Java Programming Textbook\",\n  \"description\": \"Like-new condition. Essential reference for level 2 B.Sc. IT modules.\",\n  \"price\": 2500.00,\n  \"images\": [\n    {\n      \"imageUrl\": \"https://example.com/images/java-book-front.jpg\",\n      \"sortOrder\": 1\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/listings",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
